# Copy to .env.local (git-ignored). All values optional for the demo.

# URL of the FastAPI backend (POST /analyze, POST /investigate).
# Leave empty to run all calculations in the browser.
# This is PUBLIC (shipped to the browser): never put secrets here.
NEXT_PUBLIC_API_URL=

# Optional: enables LLM answers in the chatbot (SERVER-side only, never NEXT_PUBLIC_).
# Without it the chatbot uses built-in answers grounded in the calculation engine.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
